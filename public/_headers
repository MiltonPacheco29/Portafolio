# Cabeceras de seguridad para Cloudflare Pages.
# El marcador de script-src lo sustituye scripts/csp-hashes.mjs en out/_headers
# tras cada build (hashes SHA-256 de los <script> en línea de Next y del tema).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' __CSP_SCRIPT_HASHES__ https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formspree.io; frame-src https://challenges.cloudflare.com; form-action 'self' https://formspree.io; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
