# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
*.tgz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# typescript
*.tsbuildinfo
next-env.d.ts

# env files y secretos (nunca se versionan)
.env*
.dev.vars
*.pem

# despliegue (Vercel / Cloudflare)
.vercel
.wrangler/

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# editores y herramientas (lo compartido, como .vscode/settings.json, sí se versiona)
.idea/
*.swp
.claude/settings.local.json

# Referencias de diseño de terceros (póster, prompt, retrato): solo locales.
/docs/

# Avatar del Hero de prueba (es el retrato de la referencia): no se versiona.
# Quitar esta línea cuando se sustituya por un avatar propio.
public/avatar/avatar-hola.webp
